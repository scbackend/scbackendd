# ScBackend 环境变量配置
# 复制此文件为 .env 并修改值

# ============ 必需配置 ============
# 管理界面用户名
SCBACKEND_USERNAME=admin

# 管理界面密码（强烈建议修改）
SCBACKEND_PASSWORD=change_this_strong_password

# ============ 数据库配置 ============
# 数据库类型：sqlite 或 mysql
SCBACKEND_DB_TYPE=sqlite

# SQLite 配置
SCBACKEND_SQLITE_FILENAME=scbackend.db

# MySQL 配置
SCBACKEND_MYSQL_HOST=localhost
SCBACKEND_MYSQL_PORT=3306
SCBACKEND_MYSQL_USER=root
SCBACKEND_MYSQL_PASSWORD=your_mysql_password
SCBACKEND_MYSQL_DATABASE=scbackend

# 插件数据库配置
SCBACKEND_PLUGINS_DB_TYPE=sqlite
SCBACKEND_PLUGINS_SQLITE_FILENAME=plugins.db
SCBACKEND_PLUGINS_MYSQL_HOST=localhost
SCBACKEND_PLUGINS_MYSQL_PORT=3306
SCBACKEND_PLUGINS_MYSQL_USER=root
SCBACKEND_PLUGINS_MYSQL_PASSWORD=your_plugins_db_password
SCBACKEND_PLUGINS_MYSQL_DATABASE=plugins

# ============ 服务器配置 ============
# 管理界面端口
SCBACKEND_DASH_PORT=3030

# WebSocket 服务端口
SCBACKEND_SERVICE_PORT=3031

# ============ 日志配置 ============
# 控制台日志级别：debug, info, warn, error, fatal
SCBACKEND_LOG_CONSOLE_LEVEL=info

# 文件日志级别
SCBACKEND_LOG_FILE_LEVEL=warn

# 数据库日志级别
SCBACKEND_LOG_DB_LEVEL=info

# 是否记录 Runner 网络IO
SCBACKEND_LOG_RUNNER_NETWORK_IO=false

# 静默模式（不输出控制台日志）
SCBACKEND_SILENT_MODE=false

# 日志输出目标
SCBACKEND_LOG_TO_CONSOLE=true
SCBACKEND_LOG_TO_FILE=true
SCBACKEND_LOG_TO_DB=true

# ============ 高级配置 ============
# WebSocket 最大消息大小（字节）
SCBACKEND_WS_MAX_MESSAGE_SIZE=1048576

# WebSocket 最大连接数
SCBACKEND_WS_MAX_CONNECTIONS=1000

# 请求体大小限制（字节）
SCBACKEND_MAX_BODY_SIZE=134217728

# 会话超时时间（毫秒）
SCBACKEND_SESSION_TIMEOUT=3600000

# ============ 安全配置 ============
# CORS 允许的源（逗号分隔）
SCBACKEND_CORS_ORIGINS=*

# 速率限制：每分钟最大请求数
SCBACKEND_RATE_LIMIT=100

# 是否启用 Helmet 安全头部
SCBACKEND_HELMET_ENABLED=true

# ============ 性能配置 ============
# 数据库连接池大小
SCBACKEND_DB_POOL_SIZE=10

# 日志队列大小
SCBACKEND_LOG_QUEUE_SIZE=1000

# 清理旧日志的间隔（天）
SCBACKEND_LOG_CLEANUP_DAYS=30

# ============ 开发配置 ============
# 节点环境
NODE_ENV=production

# 调试模式
DEBUG=false

# ===================================
# 注意：
# 1. 生产环境务必修改所有密码
# 2. 建议使用密码管理器生成强密码
# 3. 定期轮换密码
# 4. 不要将此文件提交到版本控制
# 5. 实际使用时应创建 .env 文件并设置适当权限
# ===================================